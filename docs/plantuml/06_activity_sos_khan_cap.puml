@startuml Activity_SOS_Khan_Cap
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activityBorderColor #4A90D9
skinparam activityBackgroundColor #E8F4FD
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityDiamondBorderColor #F59E0B
skinparam arrowColor #2C5F8A
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Biểu đồ Activity – Xử lý Tình huống Khẩn cấp (SOS)

start
if (Phương thức phát hiện/kích hoạt?) then (Bấm nút SOS trên app)
  :Người cao tuổi nhấn nút SOS khẩn cấp;
else (Cảm biến gia tốc phát hiện ngã)
  :FallDetector phát hiện va chạm mạnh / rơi tự do;
  :Ứng dụng đếm ngược cảnh báo;
  if (Người cao tuổi hủy cảnh báo kịp thời?) then (Đã hủy)
    :Hủy kích hoạt cảnh báo;
    stop
  else (Không phản hồi)
    :Tự động kích hoạt SOS;
  endif
endif

:Tạo bản ghi SosAlert với status = 'active';
fork
  :SosLocationService lấy tọa độ GPS hiện tại (latitude, longitude, accuracy);
  :Cập nhật tọa độ vào bản ghi SosAlert;
fork again
  :Gửi thông báo đẩy khẩn cấp (High Priority FCM) đến toàn bộ người thân / người chăm sóc liên kết;
  :Phát âm thanh cảnh báo lớn trên thiết bị người thân;
end fork

:Người thân nhận được thông báo cảnh báo SOS;
:Người thân mở xem chi tiết vị trí và bản đồ;

:Người thân nhấn "Xác nhận nhận tin" (Acknowledge);
:Cập nhật trạng thái cảnh báo thành 'acknowledged';

if (Người thân di chuyển tới chỗ người cao tuổi?) then (Có)
  :Nhấn nút "Đang đến" (En Route);
  :Cập nhật trạng thái thành 'enRoute';
  
  :Đến nơi hỗ trợ người cao tuổi;
  :Nhấn nút "Đã đến nơi" (Arrived);
  :Cập nhật trạng thái thành 'arrived';
else (Không)
endif

if (Kết quả giải quyết thế nào?) then (An toàn / Xử lý xong)
  :Chọn kết quả: An toàn / Nhập viện;
  :Nhập ghi chú xử lý (resolutionNote);
  :Cập nhật trạng thái thành 'resolved';
else (Báo động nhầm)
  :Nhập lý do hủy cảnh báo;
  :Cập nhật trạng thái thành 'cancelled';
endif

:Lưu sự kiện vào lịch sử cảnh báo SOS;
:Thông báo cho các thành viên khác rằng tình huống đã được xử lý;
stop
@enduml
