  |Hệ thống|
  if (kiểm tra) then (false)
    :Thông báo chỉ số đo nằm trong ngưỡng an toàn;
    goto form_UC09
  else (true)
    :Tạo thông báo cảnh báo & gửi Push FCM tới con cái;
    :Thông báo gửi cảnh báo đỏ và hiển thị chỉ dẫn y tế tại chỗ;
    stop
