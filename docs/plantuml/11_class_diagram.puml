@startuml Class_Diagram_Geriatriccare
!theme plain
skinparam backgroundColor #FAFAFA
skinparam classBorderColor #4A90D9
skinparam classBackgroundColor #FFFFFF
skinparam arrowColor #2C5F8A
skinparam packageBorderColor #708090
skinparam packageBackgroundColor #F8F9FA
skinparam titleFontSize 18
skinparam titleFontStyle bold

title Biểu đồ Lớp Thực thể (Domain Model Class Diagram) - Hệ thống Geriatriccare

package "1. Quản lý Tài khoản (Core & Authentication)" #DBEAFE {
    enum UserRole {
        elder
        child
        caregiver
        admin
    }

    enum UserGender {
        male
        female
        other
    }

    class AppUser {
        +String id
        +String phoneNumber
        +String fullName
        +String email
        +UserRole role
        +UserGender? gender
        +DateTime createdAt
        +String? avatarUrl
        +isElder(): bool
        +isChild(): bool
        +isCaregiver(): bool
    }
}

package "2. Quản lý Chỉ số Huyết áp (Health Monitoring)" #FEE2E2 {
    enum BloodPressureStatusCode {
        low
        optimal
        normal
        elevated
        highStage1
        highStage2
        crisis
    }

    class BloodPressureStatus {
        +BloodPressureStatusCode code
        +String title
        +String message
        +String ctaLabel
        +int level
        +bool needsAttention
        +bool isUrgent
    }

    class HealthRecord {
        +String id
        +String elderUserId
        +int systolic
        +int diastolic
        +int pulse
        +DateTime recordedAt
        +BloodPressureStatus status
        +bool isAbnormal
        +DateTime? contactedAt
        +String? contactedById
        +evaluateStatus(): BloodPressureStatus
    }
}

package "3. Quản lý Lịch uống thuốc (Medication Management)" #DCFCE7 {
    enum MedicationStatus {
        pending
        taken
        missed
        skipped
    }

    class PillSchedule {
        +String id
        +String elderUserId
        +String medicationName
        +String dosage
        +String instruction
        +List<int> timesInMinutes
        +DateTime startDate
        +DateTime? endDate
        +bool isActive
        +isDueToday(date): bool
    }

    class MedicationIntake {
        +String id
        +String elderUserId
        +String scheduleId
        +DateTime scheduledAt
        +DateTime? takenAt
        +MedicationStatus status
        +String? skipReason
    }

    class MedicationHistoryEntry {
        +String id
        +String elderUserId
        +String scheduleId
        +String medicationName
        +String dosage
        +DateTime scheduledAt
        +DateTime? takenAt
        +MedicationStatus status
    }
}

package "4. Tình huống Khẩn cấp SOS (Emergency SOS)" #FFEDD5 {
    enum SosTriggerMethod {
        button
        fallDetection
        shake
    }

    enum SosStatus {
        active
        acknowledged
        enRoute
        arrived
        resolved
        cancelled
    }

    class SosAlert {
        +String id
        +String elderUserId
        +SosTriggerMethod triggerMethod
        +SosStatus status
        +double? latitude
        +double? longitude
        +double? accuracyMeters
        +DateTime triggeredAt
        +DateTime? acknowledgedAt
        +String? acknowledgedById
        +DateTime? resolvedAt
        +String? resolvedById
        +String? resolutionType
        +isOngoing(): bool
        +isClosed(): bool
    }

    class ElderLocation {
        +String elderId
        +double latitude
        +double longitude
        +double accuracyMeters
        +DateTime updatedAt
    }
}

package "5. Liên kết Tài khoản & Danh bạ (Linking & Contacts)" #F3E8FF {
    enum LinkRequestStatus {
        pending
        accepted
        rejected
        cancelled
    }

    class AccountLinkRequest {
        +String id
        +String elderId
        +String elderName
        +String elderPhone
        +String? childId
        +String? childName
        +String childPhone
        +String relationship
        +LinkRequestStatus status
        +DateTime createdAt
    }

    class EmergencyContact {
        +String id
        +String elderId
        +String name
        +String relationship
        +String phoneNumber
        +int priority
    }
}

package "6. Quản lý Lịch khám Sức khỏe (Appointments)" #CCFBF1 {
    enum AppointmentStatus {
        unassigned
        assigned
        accepted
        completed
        cancelled
    }

    class MedicalAppointment {
        +String id
        +String elderUserId
        +String title
        +String hospitalName
        +String department
        +DateTime scheduledAt
        +AppointmentStatus status
        +String note
        +String createdById
        +String? assigneeId
        +String? assigneeName
    }
}

package "7. Quản lý Hồ sơ Y tế (Medical Records)" #FEF9C3 {
    class MedicalVisit {
        +String id
        +String elderUserId
        +DateTime visitDate
        +String hospitalName
        +String department
        +String doctorName
        +String diagnosis
        +String conclusion
        +DateTime? followUpDate
        +String createdById
    }

    class MedicalDocument {
        +String id
        +String visitId
        +String fileName
        +String storagePath
        +String contentType
        +String uploadedById
        +DateTime createdAt
    }
}

' ================= RELATIONS =================
AppUser "1" --> "1" UserRole : vai trò
AppUser "1" --> "0..1" UserGender : giới tính

AppUser "1" o-- "0..*" HealthRecord : theo dõi sức khỏe
HealthRecord "1" *-- "1" BloodPressureStatus : đánh giá WHO/AHA
BloodPressureStatus "1" --> "1" BloodPressureStatusCode : mã phân loại

AppUser "1" o-- "0..*" PillSchedule : thiết lập lịch thuốc
PillSchedule "1" o-- "0..*" MedicationIntake : ghi nhận cữ uống
MedicationIntake "1" --> "1" MedicationStatus : trạng thái cữ
PillSchedule "1" ..> "0..*" MedicationHistoryEntry : tổng hợp nhật ký
MedicationHistoryEntry "1" --> "1" MedicationStatus : trạng thái

AppUser "1" o-- "0..*" SosAlert : phát cảnh báo khẩn cấp
SosAlert "1" --> "1" SosStatus : trạng thái cứu hộ
SosAlert "1" --> "1" SosTriggerMethod : phương thức kích hoạt
AppUser "1" --> "0..1" ElderLocation : vị trí thời gian thực

AppUser "1" --> "0..*" AccountLinkRequest : gửi/nhận lời mời liên kết
AccountLinkRequest "1" --> "1" LinkRequestStatus : trạng thái duyệt
AppUser "1" o-- "0..*" EmergencyContact : danh bạ quay số nhanh

AppUser "1" o-- "0..*" MedicalAppointment : quản lý lịch khám
MedicalAppointment "1" --> "1" AppointmentStatus : trạng thái phân công

AppUser "1" o-- "0..*" MedicalVisit : lưu trữ sổ y bạ
MedicalVisit "1" *-- "0..*" MedicalDocument : chứa tài liệu đính kèm

@enduml
