    Repo -> Repo: Kiểm tra đã chọn người phụ trách hợp lệ
    alt Chưa chọn người phụ trách (false)
        Repo --> UI: Báo lỗi chưa chọn thành viên đưa đi khám
        UI --> Caregiver: Hiển thị thông báo yêu cầu chọn một người thân
    else Hợp lệ (true)
        Repo -> DB: updateDoc(/medical_appointments/{appointmentId}, {assignedCaregiverId, assignedCaregiverName, transportNote, isEscorted: true})
        activate DB
        DB --> Repo: Cập nhật thành công
        deactivate DB

        Repo -> Cloud: sendEscortNotification(assignedCaregiverId)
        activate Cloud
        Cloud -> Caregiver: Gửi thông báo phân công nhiệm vụ đưa cha mẹ đi khám
        deactivate Cloud

        Repo --> UI: Điều phối thành công
        deactivate Repo
        UI -> DB: Realtime update đồng bộ màn hình cha mẹ
        activate DB
        DB -> Elder: Hiển thị rõ tên người thân đưa đi trên thẻ lịch khám
        deactivate DB
        UI --> Caregiver: Thông báo điều phối người đưa đi khám thành công
    end
end
deactivate UI
@enduml

@startuml Sequence_UC18_XacNhanHoanTatLichKham
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC18: Xác nhận hoàn tất lịch khám

actor "Người dùng" as User
participant "AppointmentDetailPage" as UI
participant "AppointmentRepository" as Repo
database "Cloud Firestore" as DB

User -> UI: Mở chi tiết buổi khám bệnh sau khi khám xong
activate UI
UI -> UI: Kiểm tra thời gian hiện tại >= giờ hẹn khám
UI --> User: Hiển thị form ghi nhận kết quả (Kết luận bác sĩ, Ngày tái khám)
deactivate UI

User -> UI: Điền Kết luận của bác sĩ & Ngày hẹn tái khám (nếu có)
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng form, giữ nguyên trạng thái lịch khám
else Người dùng chọn "Xác nhận hoàn tất"
    User -> UI: Bấm "Hoàn tất buổi khám"
    UI -> Repo: completeAppointment(appointmentId, conclusion, followUpDate)
    activate Repo
    Repo -> Repo: Kiểm tra logic ngày tái khám > ngày khám hiện tại
    alt Ngày tái khám không hợp lệ (false)
        Repo --> UI: Báo lỗi ngày hẹn tái khám phải sau ngày khám hiện tại
        UI --> User: Hiển thị thông báo lỗi yêu cầu chỉnh sửa ngày tái khám
    else Hợp lệ (true)
        Repo -> DB: updateDoc(/medical_appointments/{appointmentId}, {status: "completed", completedAt: now, doctorConclusion: conclusion, followUpDate})
        activate DB
        DB --> Repo: Cập nhật thành công
        deactivate DB

        opt Có ngày hẹn tái khám
            Repo -> Repo: Tự động khởi tạo lịch khám mới cho đợt tái khám
        end

        Repo --> UI: Hoàn tất buổi khám thành công
        deactivate Repo
        UI --> User: Thông báo hoàn tất buổi khám bệnh & gợi ý tạo lịch tái khám
    end
end
deactivate UI
@enduml

@startuml Sequence_UC19_LuuHoSoYTe
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC19: Lưu hồ sơ y tế

actor "Người dùng" as User
participant "AddMedicalRecordPage\n(Tạo hồ sơ y tế)" as UI
participant "MedicalRecordRepository" as Repo
database "Cloud Firestore" as DB

User -> UI: Chọn "Tạo hồ sơ bệnh án mới"
activate UI
UI --> User: Hiển thị form nhập hồ sơ (Bệnh viện, Chẩn đoán, Ngày khám, Bác sĩ, Đơn thuốc)
deactivate UI

User -> UI: Điền Tên bệnh viện, Chẩn đoán, Ngày khám (yyyy-MM-dd), Bác sĩ, Đơn thuốc
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng form, quay lại Sổ hồ sơ bệnh án
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm "Lưu hồ sơ bệnh án"
    UI -> Repo: createMedicalRecord(elderId, recordData)
    activate Repo
    Repo -> Repo: Kiểm tra ràng buộc:
- Bệnh viện & Chẩn đoán != rỗng
- 2000-01-01 <= recordDate <= now
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi thiếu thông tin hoặc ngày khám trong tương lai
        UI --> User: Hiển thị thông báo lỗi yêu cầu điền đủ thông tin
    else Dữ liệu hợp lệ (true)
        Repo -> DB: addDoc(/medical_records, {elderId, ...recordData, createdAt: now})
        activate DB
        DB --> Repo: DocumentReference (recordId)
        deactivate DB

        Repo --> UI: Lưu hồ sơ y tế thành công
        deactivate Repo
        UI --> User: Thông báo lưu hồ sơ bệnh án thành công, chuyển sang màn hình chi tiết & gợi ý đính kèm ảnh
    end
end
deactivate UI
@enduml

@startuml Sequence_UC20_QuanLyTaiLieuDinhKem
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC20: Quản lý tài liệu đính kèm

actor "Người dùng" as User
participant "MedicalRecordDetailPage\n(Chi tiết bệnh án)" as UI
participant "Image/File Picker & Compressor" as Picker
participant "MedicalRecordRepository" as Repo
storage "Firebase Storage" as Storage
database "Cloud Firestore" as DB

User -> UI: Chọn "Đính kèm tài liệu / Ảnh xét nghiệm"
activate UI
UI -> Picker: openImagePicker()
activate Picker
Picker --> User: Mở giao diện chọn ảnh từ Camera hoặc Thư viện máy
User -> Picker: Chọn tệp ảnh hoặc PDF
Picker --> UI: Trả về File đối tượng
deactivate Picker

UI -> UI: Kiểm tra định dạng (JPG, PNG, PDF) & dung lượng (<= 10MB)
alt Định dạng sai hoặc dung lượng > 10MB (false)
    UI --> User: Báo lỗi định dạng không hỗ trợ hoặc tệp quá 10MB
else Tệp hợp lệ (true)
    User -> UI: Nhập mô tả tài liệu (tối đa 100 ký tự) & Bấm "Tải lên"
    UI -> Picker: compressImage(file)
    activate Picker
    Picker --> UI: File ảnh đã nén tối ưu
    deactivate Picker

    UI -> Repo: uploadAttachment(recordId, compressedFile, caption)
    activate Repo
    Repo -> Storage: putFile(/medical_records/{recordId}/attachments/{fileId})
    activate Storage
    Storage --> Repo: UploadTaskSnapshot & downloadUrl
    deactivate Storage

    Repo -> DB: updateDoc(/medical_records/{recordId}, {attachments: arrayUnion({fileId, downloadUrl, caption, uploadedAt: now})})
    activate DB
    DB --> Repo: Cập nhật thành công
    deactivate DB

    Repo --> UI: Tải lên tài liệu thành công
    deactivate Repo
    UI --> User: Thông báo tải lên thành công & hiển thị ảnh thu nhỏ thumbnail trên hồ sơ bệnh án
end
deactivate UI
@enduml

@startuml Sequence_UC21_TraCuuLichSuKhamBenh
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC21: Tra cứu lịch sử khám bệnh

actor "Người dùng" as User
participant "MedicalHistoryPage\n(Sổ theo dõi khám bệnh)" as UI
participant "MedicalRecordRepository" as Repo
database "Cloud Firestore" as DB

User -> UI: Mở chức năng "Sổ theo dõi khám bệnh"
activate UI
UI --> User: Hiển thị thanh tìm kiếm, bộ lọc theo năm & danh sách gần đây
deactivate UI

User -> UI: Nhập từ khóa (tên viện, bác sĩ, chẩn đoán) & Chọn năm khám
activate UI

alt Người dùng chọn "Xóa bộ lọc / Làm mới"
    User -> UI: Bấm "Đặt lại"
    UI -> Repo: getAllMedicalRecords(elderId)
    activate Repo
    Repo -> DB: query(/medical_records where elderId orderBy recordDate desc)
    activate DB
    DB --> Repo: Toàn bộ danh sách hồ sơ
    deactivate DB
    Repo --> UI: Trả về toàn bộ danh sách
    deactivate Repo
    UI --> User: Hiển thị danh sách đầy đủ ban đầu
else Người dùng chọn "Tìm kiếm"
    User -> UI: Bấm nút "Tìm kiếm"
    UI -> Repo: searchMedicalRecords(elderId, searchQuery, filterYear)
    activate Repo
    Repo -> DB: query(/medical_records where elderId, filter by year & search criteria)
    activate DB
    DB --> Repo: Danh sách List<MedicalRecord>
    deactivate DB

    alt Không tìm thấy hồ sơ nào phù hợp (false)
        Repo --> UI: Trả về danh sách rỗng
        UI --> User: Hiển thị thông báo "Không tìm thấy hồ sơ bệnh án phù hợp với từ khóa"
    else Có kết quả phù hợp (true)
        Repo -> Repo: Sắp xếp giảm dần theo ngày khám (recordDate desc)
        Repo --> UI: Trả về danh sách hồ sơ kết quả
        deactivate Repo
        UI --> User: Hiển thị danh sách thẻ tóm tắt (Ngày khám, Bệnh viện, Chẩn đoán, số tệp đính kèm)

        User -> UI: Chạm vào một thẻ hồ sơ bất kỳ
        UI --> User: Mở toàn bộ chi tiết hồ sơ bệnh án, đơn thuốc & hình ảnh xét nghiệm
    end
end
deactivate UI
@enduml