' ==============================================================================
' TOÀN BỘ 21 BIỂU ĐỒ TUẦN TỰ (UML SEQUENCE DIAGRAMS) CHI TIẾT
' DỰ ÁN: ỨNG DỤNG CHĂM SÓC NGƯỜI CAO TUỔI (GERIATRICCARE)
' BÁM SÁT 100% CÁC BIỂU ĐỒ HOẠT ĐỘNG VÀ KIẾN TRÚC THỰC TẾ
' ==============================================================================

@startuml Sequence_UC01_DangKy
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC01: Đăng ký tài khoản

actor "Người dùng" as User
participant "RegisterScreen\n(Giao diện Đăng ký)" as UI
participant "AuthRepository" as Repo
participant "OTP Server\n(Node.js REST)" as OTP
participant "Firebase Auth" as Auth
database "Cloud Firestore" as DB

User -> UI: Chọn "Đăng ký tài khoản"
activate UI
UI --> User: Hiển thị form đăng ký (SĐT, Email, PIN, Họ tên, Vai trò)
deactivate UI

User -> UI: Điền thông tin cá nhân & SĐT, Email
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ / Đã có tài khoản"
    UI --> User: Đóng form, quay về màn hình Đăng nhập
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm "Gửi mã xác thực"
    UI -> Repo: requestRegistrationOTP(email, phone)
    activate Repo
    Repo -> Repo: Kiểm tra định dạng SĐT (10 số) & Email
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi định dạng (SĐT không đủ 10 số / Email sai)
        UI --> User: Hiển thị thông báo lỗi nhập liệu
    else Dữ liệu hợp lệ (true)
        Repo -> DB: Kiểm tra SĐT trong login_directory/{phone}
        activate DB
        DB --> Repo: Kết quả kiểm tra tồn tại
        deactivate DB
        alt SĐT hoặc Email đã được đăng ký
            Repo --> UI: Báo lỗi tài khoản đã tồn tại
            UI --> User: Hiển thị "Số điện thoại hoặc Email đã được sử dụng"
        else Chưa tồn tại
            Repo -> OTP: POST /api/send-otp { email, phone }
            activate OTP
            OTP -> OTP: Sinh mã OTP 6 số (hiệu lực 5 phút)
            OTP -> User: Gửi mã OTP về email người dùng
            OTP --> Repo: 200 OK (Mã OTP đã gửi)
            deactivate OTP
            Repo --> UI: Yêu cầu nhập mã OTP
            deactivate Repo
            UI --> User: Hiển thị ô nhập mã OTP

            User -> UI: Nhập mã OTP (6 số) & Bấm "Hoàn tất đăng ký"
            UI -> Repo: completeRegistration(email, phone, pin, fullName, role, otp)
            activate Repo
            Repo -> OTP: POST /api/verify-otp { email, otp }
            activate OTP
            OTP --> Repo: 200 OK (Mã OTP hợp lệ)
            deactivate OTP

            Repo -> Auth: createUserWithEmailAndPassword(email, pin)
            activate Auth
            Auth --> Repo: UserCredential (uid)
            deactivate Auth

            Repo -> DB: setDoc(/users/{uid}, AppUser)
            activate DB
            Repo -> DB: setDoc(/login_directory/{phone}, {uid, email})
            DB --> Repo: Ghi nhận thành công
            deactivate DB

            Repo -> Auth: currentUser.sendEmailVerification()
            activate Auth
            Auth --> User: Gửi email liên kết xác thực
            deactivate Auth

            Repo --> UI: Đăng ký thành công
            deactivate Repo
            UI --> User: Hiển thị thông báo thành công & yêu cầu kiểm tra email kích hoạt
        end
    end
end
deactivate UI
@enduml

@startuml Sequence_UC02_DangNhap
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC02: Đăng nhập

actor "Người dùng" as User
participant "LoginScreen\n(Giao diện Đăng nhập)" as UI
participant "AuthRepository" as Repo
participant "Firebase Auth" as Auth
database "Cloud Firestore" as DB

User -> UI: Mở ứng dụng, chọn Đăng nhập
activate UI
UI --> User: Hiển thị form đăng nhập (SĐT & mã PIN)
deactivate UI

User -> UI: Điền số điện thoại & mã PIN
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng ứng dụng / Ở lại màn hình chờ
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm nút "Đăng nhập"
    UI -> Repo: signInWithPhone(phoneNumber, pin)
    activate Repo
    Repo -> Repo: Kiểm tra định dạng SĐT (10 số) & PIN (6 số)
    alt Định dạng không hợp lệ (false)
        Repo --> UI: Báo lỗi "SĐT phải đủ 10 số, PIN gồm 6 số"
        UI --> User: Hiển thị cảnh báo lỗi định dạng
    else Định dạng hợp lệ (true)
        Repo -> DB: getDoc(/login_directory/{phone})
        activate DB
        DB --> Repo: Trả về email liên kết
        deactivate DB

        alt Không tìm thấy SĐT trong hệ thống
            Repo --> UI: Báo lỗi "Tài khoản không tồn tại"
            UI --> User: Hiển thị "Số điện thoại hoặc mật khẩu không đúng"
        else Tìm thấy email liên kết
            Repo -> Auth: signInWithEmailAndPassword(email, pin)
            activate Auth
            Auth --> Repo: UserCredential (uid) / Exception
            deactivate Auth

            alt Sai mã PIN
                Repo --> UI: Báo lỗi "Sai mật khẩu PIN"
                UI --> User: Hiển thị "Số điện thoại hoặc mật khẩu không đúng"
            else Xác thực thành công
                Repo -> DB: getDoc(/users/{uid})
                activate DB
                DB --> Repo: AppUser data (isActive, emailVerified, role)
                deactivate DB

                alt Tài khoản bị khóa (isActive == false)
                    Repo --> UI: Báo lỗi tài khoản bị vô hiệu hóa
                    UI --> User: Hiển thị "Tài khoản của bạn đã bị khóa bởi quản trị viên"
                else Email chưa xác minh (emailVerified == false)
                    Repo --> UI: Yêu cầu xác minh email
                    UI --> User: Chuyển sang màn hình nhắc nhở kích hoạt email
                else Đủ điều kiện đăng nhập
                    Repo -> Repo: Lưu phiên làm việc & Token thiết bị
                    Repo --> UI: Đăng nhập thành công, trả về vai trò người dùng
                    deactivate Repo
                    UI --> User: Điều hướng vào Màn hình chính phù hợp (Elder Home / Child Home)
                end
            end
        end
    end
end
deactivate UI
@enduml

@startuml Sequence_UC03_DangXuat
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC03: Đăng xuất

actor "Người dùng" as User
participant "ProfileScreen\n(Giao diện Cài đặt)" as UI
participant "AuthRepository" as Repo
participant "Firebase Auth" as Auth
database "Cloud Firestore" as DB

User -> UI: Chọn chức năng "Đăng xuất"
activate UI
UI --> User: Hiển thị hộp thoại xác nhận: "Bạn có chắc chắn muốn đăng xuất?"
deactivate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    activate UI
    UI --> User: Đóng hộp thoại, giữ nguyên phiên làm việc
    deactivate UI
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm nút "Đồng ý Đăng xuất"
    activate UI
    UI -> Repo: signOut()
    activate Repo
    Repo -> Repo: Hủy tất cả Realtime Streams / Listeners
    Repo -> DB: updateDoc(/users/{uid}, {fcmToken: null})
    activate DB
    DB --> Repo: Xóa token thành công
    deactivate DB
    Repo -> Auth: signOut()
    activate Auth
    Auth --> Repo: Đã hủy phiên xác thực
    deactivate Auth
    Repo -> Repo: Xóa cache phiên làm việc cục bộ
    Repo --> UI: Hoàn tất đăng xuất
    deactivate Repo
    UI --> User: Thông báo đăng xuất thành công, chuyển về LoginScreen
    deactivate UI
end
@enduml

@startuml Sequence_UC04_GuiCanhBaoSOS
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC04: Gửi cảnh báo SOS

actor "Người cao tuổi" as Elder
participant "SosScreen / Service\n(Ứng dụng)" as UI
participant "Sensor / GPS Service" as Sensor
participant "SosRepository" as Repo
database "Cloud Firestore" as DB
participant "Cloud Functions & FCM" as Cloud
actor "Con cái / Người thân" as Caregiver

alt Kích hoạt thủ công
    Elder -> UI: Nhấn giữ nút "SOS Khẩn Cấp" trong 1 giây
else Kích hoạt tự động
    Sensor -> UI: Cảm biến gia tốc phát hiện ngã (> 2.5G)
end

activate UI
UI -> UI: Phát còi hú báo động âm lượng tối đa & đếm ngược 15s
UI --> Elder: Hiển thị màn hình đếm ngược khẩn cấp

alt Người cao tuổi chọn "Huỷ" (Bấm nhầm)
    Elder -> UI: Bấm nút "Tôi ổn / Huỷ báo động"
    UI -> UI: Tắt còi hú & dừng đếm ngược
    UI --> Elder: Đã hủy cảnh báo khẩn cấp
else Hết 15 giây hoặc chọn "Xác nhận gửi ngay"
    Elder -> UI: Bấm "Gửi ngay" (hoặc hết thời gian đếm ngược)
    UI -> Sensor: getCurrentLocation()
    activate Sensor
    Sensor --> UI: Tọa độ GPS (latitude, longitude)
    deactivate Sensor

    UI -> Repo: sendEmergencyAlert(elderId, alertType, location)
    activate Repo
    Repo -> DB: addDoc(/emergency_alerts, {elderId, alertType, location, status: "active", createdAt: now})
    activate DB
    DB --> Repo: DocumentReference (alertId)
    deactivate DB

    Repo -> Cloud: Trigger sendCriticalNotification(alertId)
    activate Cloud
    Cloud -> DB: Truy vấn danh sách con cái liên kết (/family_links)
    activate DB
    DB --> Cloud: Danh sách caregiverIds & FCM Tokens
    deactivate DB
    Cloud -> Caregiver: Gửi Push Notification âm lượng tối đa (Critical Alert)
    deactivate Cloud

    Repo --> UI: Gửi cảnh báo thành công
    deactivate Repo
    UI --> Elder: Thông báo đã gửi cảnh báo SOS tới toàn bộ người thân
end
deactivate UI
@enduml

@startuml Sequence_UC05_TiepNhanCanhBao
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC05: Tiếp nhận cảnh báo

actor "Con cái / Người thân" as Caregiver
participant "EmergencyAlertPage\n(Giao diện Cảnh báo)" as UI
participant "SosRepository" as Repo
database "Cloud Firestore" as DB
participant "Google Maps / Dialer" as External
actor "Người cao tuổi" as Elder

Caregiver -> UI: Chạm vào thông báo đẩy khẩn cấp từ thanh thông báo
activate UI
UI -> Repo: getEmergencyAlertDetail(alertId)
activate Repo
Repo -> DB: getDoc(/emergency_alerts/{alertId})
activate DB
DB --> Repo: Dữ liệu cảnh báo (status, location, elderName, time)
deactivate DB
Repo --> UI: Trả về thông tin chi tiết
deactivate Repo

alt Cảnh báo đã được người thân khác xử lý (status == "resolved")
    UI --> Caregiver: Hiển thị "Tình huống đã được [Tên người thân] xử lý an toàn"
else Cảnh báo đang hoạt động (status == "active")
    UI --> Caregiver: Hiển thị bản đồ Google Maps ghim vị trí cha mẹ & loại cảnh báo

    alt Con cái chọn hành động "Gọi điện thoại ngay"
        Caregiver -> UI: Bấm nút "Gọi điện thoại ngay"
        UI -> External: url_launcher("tel:09xxxxxxxx")
        activate External
        External -> Elder: Kết nối cuộc gọi viễn thông trực tiếp
        deactivate External
    else Con cái chọn hành động "Chỉ đường"
        Caregiver -> UI: Bấm nút "Chỉ đường qua Google Maps"
        UI -> External: url_launcher("https://maps.google.com/?q=lat,lng")
        activate External
        External --> Caregiver: Mở ứng dụng Google Maps dẫn đường tới vị trí
        deactivate External
    end
end
deactivate UI
@enduml

@startuml Sequence_UC06_XuLyCanhBao
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC06: Xử lý cảnh báo

actor "Con cái / Người thân" as Caregiver
participant "EmergencyAlertPage" as UI
participant "SosRepository" as Repo
database "Cloud Firestore" as DB
actor "Người cao tuổi" as Elder

Caregiver -> UI: Chọn "Cập nhật xử lý tình huống"
activate UI
UI --> Caregiver: Hiển thị form kết luận (Hình thức xử lý, Ghi chú)
deactivate UI

Caregiver -> UI: Điền hình thức (safe/hospitalized/false_alarm) & ghi chú
activate UI

alt Con cái chọn "Huỷ"
    Caregiver -> UI: Bấm nút "Huỷ"
    UI --> Caregiver: Đóng form, giữ nguyên màn hình cảnh báo
else Con cái chọn "Xác nhận hoàn tất"
    Caregiver -> UI: Bấm "Xác nhận xử lý"
    UI -> Repo: resolveEmergencyAlert(alertId, resolutionType, resolutionNote)
    activate Repo
    Repo -> Repo: Kiểm tra ràng buộc (resolutionType != null, note <= 300 ký tự)
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi chưa chọn hình thức hoặc ghi chú quá dài
        UI --> Caregiver: Hiển thị thông báo lỗi yêu cầu chọn kết quả
    else Dữ liệu hợp lệ (true)
        Repo -> DB: updateDoc(/emergency_alerts/{alertId}, {status: "resolved", resolvedBy: childId, resolvedAt: now, resolutionType, resolutionNote})
        activate DB
        DB --> Repo: Cập nhật thành công
        deactivate DB

        Repo -> DB: Realtime update đồng bộ máy cha mẹ
        activate DB
        DB -> Elder: Gửi tín hiệu Realtime tắt còi hú & báo an toàn
        deactivate DB

        Repo --> UI: Xử lý tình huống thành công
        deactivate Repo
        UI --> Caregiver: Thông báo hoàn tất xử lý tình huống an toàn, chuyển thẻ đã xử lý
    end
end
deactivate UI
@enduml

@startuml Sequence_UC07_GhiChiSoHuyetAp
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC07: Ghi chỉ số huyết áp

actor "Người dùng" as User
participant "AddBloodPressurePage\n(Giao diện Nhập)" as UI
participant "HealthRepository" as Repo
database "Cloud Firestore" as DB
participant "Cloud Functions & FCM" as Cloud
actor "Con cái / Người thân" as Caregiver

User -> UI: Chọn "Ghi nhận huyết áp"
activate UI
UI --> User: Hiển thị form đo huyết áp (Tâm thu, Tâm trương, Nhịp tim, Ghi chú)
deactivate UI

User -> UI: Điền chỉ số Tâm thu, Tâm trương, Nhịp tim & Ghi chú
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng form, quay lại màn hình Sức khỏe
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm "Lưu kết quả"
    UI -> Repo: saveBloodPressureRecord(elderId, systolic, diastolic, pulse, note)
    activate Repo
    Repo -> Repo: Kiểm tra ràng buộc y tế:
- 70 <= systolic <= 250
- 40 <= diastolic <= 150
- systolic > diastolic
- 30 <= pulse <= 220
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi vi phạm dải đo y tế hoặc logic tâm thu <= tâm trương
        UI --> User: Hiển thị hộp thoại cảnh báo chỉ số đo không hợp lệ
    else Dữ liệu hợp lệ (true)
        Repo -> Repo: Phân loại theo tiêu chuẩn WHO/AHA
(Bình thường / Tiền THA / Độ 1 / Độ 2 / Thấp)
        Repo -> DB: addDoc(/blood_pressure_records, recordData)
        activate DB
        DB --> Repo: DocumentReference (recordId)
        Repo -> DB: updateDoc(/users/{elderId}, {latestBP: recordData})
        DB --> Repo: Cập nhật thành công
        deactivate DB

        opt Chỉ số bất thường nguy hiểm (Systolic >= 160 hoặc Diastolic >= 100)
            Repo -> Cloud: Trigger cảnh báo bất thường (UC09)
            activate Cloud
            Cloud -> Caregiver: Gửi Push Notification "Cảnh báo huyết áp báo động!"
            deactivate Cloud
        end

        Repo --> UI: Lưu kết quả thành công kèm phân loại
        deactivate Repo
        UI --> User: Thông báo lưu thành công & hiển thị thẻ kết quả kèm khuyến nghị y tế
    end
end
deactivate UI
@enduml

@startuml Sequence_UC08_TheoDoiLichSuHuyetAp
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC08: Theo dõi lịch sử huyết áp

actor "Người dùng" as User
participant "BloodPressureHistoryPage\n(Giao diện Lịch sử)" as UI
participant "HealthRepository" as Repo
database "Cloud Firestore" as DB

User -> UI: Chọn "Lịch sử đo huyết áp"
activate UI
UI --> User: Hiển thị giao diện bộ lọc thời gian (7 ngày, 30 ngày, Tùy chọn)
deactivate UI

User -> UI: Chọn khoảng thời gian (startDate, endDate)
activate UI

alt Người dùng chọn khoảng ngày không hợp lệ (startDate > endDate)
    UI --> User: Báo lỗi "Ngày bắt đầu không được lớn hơn ngày kết thúc"
else Khoảng thời gian hợp lệ
    UI -> Repo: getBloodPressureHistory(elderId, startDate, endDate)
    activate Repo
    Repo -> DB: query(/blood_pressure_records, where elderId, date range, orderBy measuredAt desc)
    activate DB
    DB --> Repo: Danh sách List<BloodPressureRecord>
    deactivate DB

    alt Chưa có dữ liệu đo
        Repo --> UI: Trả về danh sách rỗng
        UI --> User: Hiển thị màn hình trống "Chưa có dữ liệu đo trong khoảng này"
    else Có dữ liệu đo
        Repo -> Repo: Tính toán chỉ số trung bình (SysAvg, DiaAvg, PulseAvg) & tỷ lệ bất thường
        Repo --> UI: Trả về danh sách bản ghi & số liệu thống kê
        deactivate Repo
        UI -> UI: Dựng biểu đồ đường biến thiên huyết áp (LineChart)
        UI --> User: Hiển thị biểu đồ xu hướng & danh sách chi tiết các lần đo có màu cảnh báo
    end
end
