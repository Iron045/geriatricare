@startuml Sequence_UC01_DangKy
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC01: Đăng ký tài khoản

actor "Người dùng" as User
participant "RegisterScreen\n(Giao diện Đăng ký)" as UI
participant "AuthRepository" as Repo
participant "OTP Server\n(Node.js REST)" as OTP
participant "Firebase Auth" as Auth
database "Cloud Firestore" as DB

User -> UI: Chọn "Đăng ký tài khoản"
activate UI
UI --> User: Hiển thị form đăng ký (SĐT, Email, PIN, Họ tên, Vai trò)
deactivate UI

User -> UI: Điền thông tin cá nhân & SĐT, Email
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ / Đã có tài khoản"
    UI --> User: Đóng form, quay về màn hình Đăng nhập
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm "Gửi mã xác thực"
    UI -> Repo: requestRegistrationOTP(email, phone)
    activate Repo
    Repo -> Repo: Kiểm tra định dạng SĐT (10 số) & Email
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi định dạng (SĐT không đủ 10 số / Email sai)
        UI --> User: Hiển thị thông báo lỗi nhập liệu
    else Dữ liệu hợp lệ (true)
        Repo -> DB: Kiểm tra SĐT trong login_directory/{phone}
        activate DB
        DB --> Repo: Kết quả kiểm tra tồn tại
        deactivate DB
        alt SĐT hoặc Email đã được đăng ký
            Repo --> UI: Báo lỗi tài khoản đã tồn tại
            UI --> User: Hiển thị "Số điện thoại hoặc Email đã được sử dụng"
        else Chưa tồn tại
            Repo -> OTP: POST /api/send-otp { email, phone }
            activate OTP
            OTP -> OTP: Sinh mã OTP 6 số (hiệu lực 5 phút)
            OTP -> User: Gửi mã OTP về email người dùng
            OTP --> Repo: 200 OK (Mã OTP đã gửi)
            deactivate OTP
            Repo --> UI: Yêu cầu nhập mã OTP
            deactivate Repo
            UI --> User: Hiển thị ô nhập mã OTP

            User -> UI: Nhập mã OTP (6 số) & Bấm "Hoàn tất đăng ký"
            UI -> Repo: completeRegistration(email, phone, pin, fullName, role, otp)
            activate Repo
            Repo -> OTP: POST /api/verify-otp { email, otp }
            activate OTP
            OTP --> Repo: 200 OK (Mã OTP hợp lệ)
            deactivate OTP

            Repo -> Auth: createUserWithEmailAndPassword(email, pin)
            activate Auth
            Auth --> Repo: UserCredential (uid)
            deactivate Auth

            Repo -> DB: setDoc(/users/{uid}, AppUser)
            activate DB
            Repo -> DB: setDoc(/login_directory/{phone}, {uid, email})
            DB --> Repo: Ghi nhận thành công
            deactivate DB

            Repo -> Auth: currentUser.sendEmailVerification()
            activate Auth
            Auth --> User: Gửi email liên kết xác thực
            deactivate Auth

            Repo --> UI: Đăng ký thành công
            deactivate Repo
            UI --> User: Hiển thị thông báo thành công & yêu cầu kiểm tra email kích hoạt
        end
    end
end
deactivate UI
@enduml