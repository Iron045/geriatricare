@startuml Sequence_UC16_TaoLichKhamSucKhoe
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC16: Tạo lịch khám sức khỏe

actor "Người dùng" as User
participant "CreateAppointmentPage\n(Tạo lịch khám)" as UI
participant "AppointmentRepository" as Repo
database "Cloud Firestore" as DB
participant "Cloud Functions & FCM" as Cloud
actor "Người thân trong gia đình" as Family

User -> UI: Chọn "Tạo lịch khám bệnh mới"
activate UI
UI --> User: Hiển thị form tạo lịch (Tiêu đề, Bệnh viện, Bác sĩ, Thời gian khám, Ghi chú)
deactivate UI

User -> UI: Điền Tiêu đề, Bệnh viện, Bác sĩ, Ngày giờ hẹn khám, Ghi chú
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng form, quay lại Lịch khám sức khỏe
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm "Lưu lịch khám"
    UI -> Repo: createAppointment(elderId, appointmentData)
    activate Repo
    Repo -> Repo: Kiểm tra dữ liệu:
- Tiêu đề & Bệnh viện != rỗng
- appointmentDate > now + 30 phút
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi thiếu thông tin hoặc thời gian khám trong quá khứ
        UI --> User: Hiển thị thông báo lỗi yêu cầu chọn lại thời gian
    else Dữ liệu hợp lệ (true)
        Repo -> DB: addDoc(/medical_appointments, {elderId, ...appointmentData, status: "scheduled"})
        activate DB
        DB --> Repo: DocumentReference (appointmentId)
        deactivate DB

        Repo -> Cloud: sendAppointmentReminderToFamily(appointmentId)
        activate Cloud
        Cloud -> Family: Gửi Push Notification thông báo lịch khám bệnh mới của cha mẹ
        deactivate Cloud

        Repo --> UI: Tạo lịch khám thành công
        deactivate Repo
        UI --> User: Thông báo lưu lịch khám thành công & đồng bộ hiển thị lên lịch gia đình
    end
end
deactivate UI
@enduml