@startuml Sequence_UC05_TiepNhanCanhBao
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC05: Tiếp nhận cảnh báo

actor "Con cái / Người thân" as Caregiver
participant "EmergencyAlertPage\n(Giao diện Cảnh báo)" as UI
participant "SosRepository" as Repo
database "Cloud Firestore" as DB
participant "Google Maps / Dialer" as External
actor "Người cao tuổi" as Elder

Caregiver -> UI: Chạm vào thông báo đẩy khẩn cấp từ thanh thông báo
activate UI
UI -> Repo: getEmergencyAlertDetail(alertId)
activate Repo
Repo -> DB: getDoc(/emergency_alerts/{alertId})
activate DB
DB --> Repo: Dữ liệu cảnh báo (status, location, elderName, time)
deactivate DB
Repo --> UI: Trả về thông tin chi tiết
deactivate Repo

alt Cảnh báo đã được người thân khác xử lý (status == "resolved")
    UI --> Caregiver: Hiển thị "Tình huống đã được [Tên người thân] xử lý an toàn"
else Cảnh báo đang hoạt động (status == "active")
    UI --> Caregiver: Hiển thị bản đồ Google Maps ghim vị trí cha mẹ & loại cảnh báo

    alt Con cái chọn hành động "Gọi điện thoại ngay"
        Caregiver -> UI: Bấm nút "Gọi điện thoại ngay"
        UI -> External: url_launcher("tel:09xxxxxxxx")
        activate External
        External -> Elder: Kết nối cuộc gọi viễn thông trực tiếp
        deactivate External
    else Con cái chọn hành động "Chỉ đường"
        Caregiver -> UI: Bấm nút "Chỉ đường qua Google Maps"
        UI -> External: url_launcher("https://maps.google.com/?q=lat,lng")
        activate External
        External --> Caregiver: Mở ứng dụng Google Maps dẫn đường tới vị trí
        deactivate External
    end
end
deactivate UI
@enduml