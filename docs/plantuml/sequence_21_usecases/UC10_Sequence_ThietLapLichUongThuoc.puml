@startuml Sequence_UC10_ThietLapLichUongThuoc
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC10: Thiết lập lịch uống thuốc

actor "Người dùng" as User
participant "AddMedicationPage\n(Giao diện Thêm lịch)" as UI
participant "MedicationRepository" as Repo
participant "LocalNotificationService\n(Báo thức máy)" as Alarm
database "Cloud Firestore" as DB

User -> UI: Chọn "Thêm lịch uống thuốc"
activate UI
UI --> User: Hiển thị form thiết lập lịch thuốc (Tên thuốc, Liều lượng, Giờ nhắc, Ngày bắt đầu/kết thúc)
deactivate UI

User -> UI: Điền Tên thuốc, Liều lượng, Khung giờ nhắc (HH:mm), Ngày điều trị
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng form, quay lại Tủ thuốc gia đình
else Người dùng chọn "Xác nhận"
    User -> UI: Bấm "Lưu lịch uống thuốc"
    UI -> Repo: createMedicationSchedule(elderId, scheduleData)
    activate Repo
    Repo -> Repo: Kiểm tra ràng buộc (Tên thuốc != rỗng, giờ nhắc >= 1 mốc, endDate >= startDate)
    alt Dữ liệu không hợp lệ (false)
        Repo --> UI: Báo lỗi thiếu thông tin hoặc ngày kết thúc sai
        UI --> User: Hiển thị thông báo lỗi yêu cầu hoàn thiện thông tin
    else Dữ liệu hợp lệ (true)
        Repo -> DB: addDoc(/medication_schedules, scheduleData)
        activate DB
        DB --> Repo: DocumentReference (scheduleId)
        deactivate DB

        Repo -> Alarm: scheduleLocalAlarms(scheduleId, reminderTimes)
        activate Alarm
        Alarm -> Alarm: Đăng ký kênh báo thức Local Notifications theo giờ
        Alarm --> Repo: Đăng ký thành công
        deactivate Alarm

        Repo --> UI: Thiết lập lịch thuốc thành công
        deactivate Repo
        UI --> User: Thông báo lưu lịch thuốc thành công & cập nhật vào danh sách điều trị
    end
end
deactivate UI
@enduml