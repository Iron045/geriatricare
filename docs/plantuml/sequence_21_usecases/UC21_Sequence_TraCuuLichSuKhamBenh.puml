@startuml Sequence_UC21_TraCuuLichSuKhamBenh
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC21: Tra cứu lịch sử khám bệnh

actor "Người dùng" as User
participant "MedicalHistoryPage\n(Sổ theo dõi khám bệnh)" as UI
participant "MedicalRecordRepository" as Repo
database "Cloud Firestore" as DB

User -> UI: Mở chức năng "Sổ theo dõi khám bệnh"
activate UI
UI --> User: Hiển thị thanh tìm kiếm, bộ lọc theo năm & danh sách gần đây
deactivate UI

User -> UI: Nhập từ khóa (tên viện, bác sĩ, chẩn đoán) & Chọn năm khám
activate UI

alt Người dùng chọn "Xóa bộ lọc / Làm mới"
    User -> UI: Bấm "Đặt lại"
    UI -> Repo: getAllMedicalRecords(elderId)
    activate Repo
    Repo -> DB: query(/medical_records where elderId orderBy recordDate desc)
    activate DB
    DB --> Repo: Toàn bộ danh sách hồ sơ
    deactivate DB
    Repo --> UI: Trả về toàn bộ danh sách
    deactivate Repo
    UI --> User: Hiển thị danh sách đầy đủ ban đầu
else Người dùng chọn "Tìm kiếm"
    User -> UI: Bấm nút "Tìm kiếm"
    UI -> Repo: searchMedicalRecords(elderId, searchQuery, filterYear)
    activate Repo
    Repo -> DB: query(/medical_records where elderId, filter by year & search criteria)
    activate DB
    DB --> Repo: Danh sách List<MedicalRecord>
    deactivate DB

    alt Không tìm thấy hồ sơ nào phù hợp (false)
        Repo --> UI: Trả về danh sách rỗng
        UI --> User: Hiển thị thông báo "Không tìm thấy hồ sơ bệnh án phù hợp với từ khóa"
    else Có kết quả phù hợp (true)
        Repo -> Repo: Sắp xếp giảm dần theo ngày khám (recordDate desc)
        Repo --> UI: Trả về danh sách hồ sơ kết quả
        deactivate Repo
        UI --> User: Hiển thị danh sách thẻ tóm tắt (Ngày khám, Bệnh viện, Chẩn đoán, số tệp đính kèm)

        User -> UI: Chạm vào một thẻ hồ sơ bất kỳ
        UI --> User: Mở toàn bộ chi tiết hồ sơ bệnh án, đơn thuốc & hình ảnh xét nghiệm
    end
end
deactivate UI
@enduml