@startuml Sequence_UC17_DieuPhoiNguoiDuaDiKham
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC17: Điều phối người đưa đi khám

actor "Con cái / Người thân" as Caregiver
participant "AppointmentDetailPage\n(Chi tiết lịch khám)" as UI
participant "AppointmentRepository" as Repo
database "Cloud Firestore" as DB
participant "Cloud Functions & FCM" as Cloud
actor "Người cao tuổi" as Elder

Caregiver -> UI: Mở chi tiết lịch khám bệnh của cha mẹ
activate UI
UI --> Caregiver: Hiển thị thông tin lịch khám & các nút phân công đưa đi
deactivate UI

Caregiver -> UI: Chọn thành viên phụ trách (tự nhận hoặc chọn người thân) & Ghi chú xe cộ
activate UI

alt Con cái chọn "Huỷ"
    Caregiver -> UI: Bấm nút "Huỷ"
    UI --> Caregiver: Giữ nguyên lịch khám, không thay đổi người đưa đi
else Con cái chọn "Xác nhận điều phối"
    Caregiver -> UI: Bấm "Xác nhận điều phối"
    UI -> Repo: assignCaregiverToAppointment(appointmentId, assignedCaregiverId, transportNote)
    activate Repo
    Repo -> Repo: Kiểm tra đã chọn người phụ trách hợp lệ
    alt Chưa chọn người phụ trách (false)
        Repo --> UI: Báo lỗi chưa chọn thành viên đưa đi khám
        UI --> Caregiver: Hiển thị thông báo yêu cầu chọn một người thân
    else Hợp lệ (true)
        Repo -> DB: updateDoc(/medical_appointments/{appointmentId}, {assignedCaregiverId, assignedCaregiverName, transportNote, isEscorted: true})
        activate DB
        DB --> Repo: Cập nhật thành công
        deactivate DB

        Repo -> Cloud: sendEscortNotification(assignedCaregiverId)
        activate Cloud
        Cloud -> Caregiver: Gửi thông báo phân công nhiệm vụ đưa cha mẹ đi khám
        deactivate Cloud

        Repo --> UI: Điều phối thành công
        deactivate Repo
        UI -> DB: Realtime update đồng bộ màn hình cha mẹ
        activate DB
        DB -> Elder: Hiển thị rõ tên người thân đưa đi trên thẻ lịch khám
        deactivate DB
        UI --> Caregiver: Thông báo điều phối người đưa đi khám thành công
    end
end
deactivate UI
@enduml