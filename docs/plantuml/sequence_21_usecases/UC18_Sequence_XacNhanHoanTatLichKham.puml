@startuml Sequence_UC18_XacNhanHoanTatLichKham
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC18: Xác nhận hoàn tất lịch khám

actor "Người dùng" as User
participant "AppointmentDetailPage" as UI
participant "AppointmentRepository" as Repo
database "Cloud Firestore" as DB

User -> UI: Mở chi tiết buổi khám bệnh sau khi khám xong
activate UI
UI -> UI: Kiểm tra thời gian hiện tại >= giờ hẹn khám
UI --> User: Hiển thị form ghi nhận kết quả (Kết luận bác sĩ, Ngày tái khám)
deactivate UI

User -> UI: Điền Kết luận của bác sĩ & Ngày hẹn tái khám (nếu có)
activate UI

alt Người dùng chọn "Huỷ"
    User -> UI: Bấm nút "Huỷ"
    UI --> User: Đóng form, giữ nguyên trạng thái lịch khám
else Người dùng chọn "Xác nhận hoàn tất"
    User -> UI: Bấm "Hoàn tất buổi khám"
    UI -> Repo: completeAppointment(appointmentId, conclusion, followUpDate)
    activate Repo
    Repo -> Repo: Kiểm tra logic ngày tái khám > ngày khám hiện tại
    alt Ngày tái khám không hợp lệ (false)
        Repo --> UI: Báo lỗi ngày hẹn tái khám phải sau ngày khám hiện tại
        UI --> User: Hiển thị thông báo lỗi yêu cầu chỉnh sửa ngày tái khám
    else Hợp lệ (true)
        Repo -> DB: updateDoc(/medical_appointments/{appointmentId}, {status: "completed", completedAt: now, doctorConclusion: conclusion, followUpDate})
        activate DB
        DB --> Repo: Cập nhật thành công
        deactivate DB

        opt Có ngày hẹn tái khám
            Repo -> Repo: Tự động khởi tạo lịch khám mới cho đợt tái khám
        end

        Repo --> UI: Hoàn tất buổi khám thành công
        deactivate Repo
        UI --> User: Thông báo hoàn tất buổi khám bệnh & gợi ý tạo lịch tái khám
    end
end
deactivate UI
@enduml