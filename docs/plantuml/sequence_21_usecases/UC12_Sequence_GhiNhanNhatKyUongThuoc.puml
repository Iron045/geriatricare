@startuml Sequence_UC12_GhiNhanNhatKyUongThuoc
!theme plain
autonumber
skinparam backgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #4A90D9
skinparam sequenceParticipantBackgroundColor #E8F4FD
skinparam sequenceLifeLineBorderColor #4A90D9
skinparam sequenceArrowColor #2C5F8A
skinparam sequenceGroupBorderColor #F59E0B
skinparam sequenceGroupBackgroundColor #FFFDE7
skinparam titleFontSize 15
skinparam titleFontStyle bold

title Biểu đồ Tuần tự – UC12: Ghi nhận nhật ký uống thuốc

actor "Người cao tuổi" as Elder
participant "TodayMedicationPage" as UI
participant "MedicationRepository" as Repo
database "Cloud Firestore" as DB
actor "Con cái / Người thân" as Caregiver

Elder -> UI: Xem thẻ cữ thuốc đang chờ (pending)
activate UI

alt Người cao tuổi chọn "Đã uống"
    Elder -> UI: Bấm nút "Đã uống"
    UI -> Repo: logMedicationIntake(scheduleId, status: "taken", takenAt: now)
    activate Repo
    Repo -> DB: addDoc(/medication_logs, {scheduleId, status: "taken", takenAt: now})
    activate DB
    DB --> Repo: Ghi nhật ký thành công
    deactivate DB
    Repo -> Repo: Tính lại tỷ lệ tuân thủ điều trị
    Repo --> UI: Cập nhật thành công
    deactivate Repo
    UI --> Elder: Chuyển thẻ thuốc sang màu xanh (Đã uống)
else Người cao tuổi chọn "Bỏ qua"
    Elder -> UI: Bấm nút "Bỏ qua"
    UI --> Elder: Hiển thị popup yêu cầu nhập lý do bỏ qua
    Elder -> UI: Nhập hoặc chọn lý do (skipReason) & Bấm "Xác nhận"
    alt Lý do để trống (false)
        UI --> Elder: Báo lỗi "Vui lòng nhập lý do bỏ qua cữ thuốc"
    else Lý do hợp lệ (true)
        UI -> Repo: logMedicationIntake(scheduleId, status: "skipped", skipReason, takenAt: now)
        activate Repo
        Repo -> DB: addDoc(/medication_logs, {scheduleId, status: "skipped", skipReason, takenAt: now})
        activate DB
        DB --> Repo: Ghi nhật ký thành công
        deactivate DB
        Repo --> UI: Cập nhật thành công
        deactivate Repo
        UI --> Elder: Chuyển thẻ thuốc sang màu xám (Đã bỏ qua)
    end
end

UI -> DB: Realtime update đồng bộ tiến độ
activate DB
DB -> Caregiver: Cập nhật thông báo trạng thái uống thuốc về máy con cái
deactivate DB
deactivate UI
@enduml