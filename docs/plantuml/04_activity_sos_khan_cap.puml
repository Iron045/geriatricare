@startuml Activity_02_TinhHuongKhanCap
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activityBorderColor #C0392B
skinparam activityBackgroundColor #FDEDEC
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityDiamondBorderColor #F59E0B
skinparam arrowColor #922B21
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Biểu đồ Hoạt động (Activity Diagram) - Phân hệ 2: Quản lý Tình huống Khẩn cấp (UC04, UC05, UC06)

|Thiết bị Người cao tuổi|
start
:Sự kiện kích hoạt cảnh báo (UC04);
if (Phương thức kích hoạt?) then (Bấm nút thủ công)
    :Nhấn và giữ nút 'SOS Khẩn Cấp' trong 1 giây;
else (Cảm biến tự động)
    :Cảm biến gia tốc phát hiện rơi ngã đột ngột (>2.5G);
    :Kích hoạt màn hình đếm ngược 15 giây;
    if (Người cao tuổi nhấn 'Tôi ổn / Bấm nhầm'?) then (Có)
        :Hủy đếm ngược và tắt báo động;
        stop
    else (Hết 15 giây không hủy)
    endif
endif

:Bật còi hú báo động âm lượng tối đa & rung liên tục;
:Thu thập tọa độ vị trí hiện thời (GPS);
if (Tọa độ GPS khả dụng?) then (Có)
    :Đóng gói tọa độ (Vĩ độ, Kinh độ);
else (Không có tín hiệu)
    :Lấy tọa độ ghi nhận lần gần nhất (hoặc đánh dấu locationUnavailable);
endif

|Hệ thống Backend (Firebase)|
:Tạo bản ghi cảnh báo trong Firestore 'emergency_alerts/{id}';
note right: status = 'active'\nalertType = 'manual_sos' hoặc 'fall_detected'\ncreatedAt = now
:Kích hoạt Firebase Cloud Messaging (FCM);
:Gửi Push Notification ưu tiên cao (Critical Alert) đến người thân;

|Thiết bị Con cái / Người thân|
:Nhận thông báo đẩy khẩn cấp phá vỡ chế độ im lặng;
:Mở màn hình cảnh báo khẩn cấp (UC05 - EmergencyAlertPage);
:Hiển thị bản đồ Google Maps và vị trí người cao tuổi;
:Hiển thị thông tin loại cảnh báo và thời gian xảy ra;
fork
    :Con cái nhấn 'Gọi điện thoại ngay' để liên hệ cha mẹ;
fork again
    :Con cái nhấn 'Chỉ đường' để di chuyển nhanh đến vị trí;
end fork

|Thiết bị Con cái / Người thân|
:Sau khi tiếp cận hoặc xác minh tình hình an toàn;
:Nhấn nút 'Cập nhật xử lý tình huống' (UC06);
:Chọn hình thức xử lý (safe / hospitalized / false_alarm);
:Nhập ghi chú xử lý (tối đa 300 ký tự);
:Nhấn nút 'Xác nhận hoàn tất xử lý';

|Hệ thống Backend (Firebase)|
:Cập nhật bản ghi cảnh báo trong Firestore;
note right: status = 'resolved'\nresolvedBy = con_cai_id\nresolvedAt = now\nresolutionType, resolutionNote
:Phát tín hiệu Realtime đồng bộ trạng thái an toàn;

|Thiết bị Người cao tuổi|
:Tự động tắt còi báo động khẩn cấp;
:Hiển thị thông báo: 'Tình huống đã được con cái hỗ trợ an toàn';

|Thiết bị Con cái / Người thân|
:Cập nhật giao diện thẻ cảnh báo chuyển sang trạng thái Đã xử lý;
stop
@enduml