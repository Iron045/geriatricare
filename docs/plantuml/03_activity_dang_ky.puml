@startuml Activity_DangKy_DangNhap
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activityBorderColor #4A90D9
skinparam activityBackgroundColor #E8F4FD
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityDiamondBorderColor #F59E0B
skinparam arrowColor #2C5F8A
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Biểu đồ Activity – Đăng ký & Đăng nhập

start
:Mở ứng dụng;
if (Đã đăng nhập?) then (Có)
    :Màn hình chính;
    stop
else (Không)
    :Hiển thị màn hình đăng nhập;
endif

if (Có tài khoản?) then (Có)
    :Nhập số điện thoại và mật khẩu;
    :Gửi yêu cầu đăng nhập\nFirebase Auth;
    if (Xác thực thành công?) then (Thành công)
        if (Email đã xác minh?) then (Đã xác minh)
            :Màn hình chính;
            stop
        else (Chưa xác minh)
            :Màn hình xác minh email;
            :Gửi email xác minh;
            repeat
                :Chờ người dùng xác minh email;
                :Kiểm tra trạng thái xác minh;
            repeat while (Email đã được xác minh?) is (Chưa) not (Đã xác minh)
            :Màn hình chính;
            stop
        endif
    else (Thất bại)
        :Hiển thị thông báo lỗi;
        :Quay lại màn hình đăng nhập;
        stop
    endif
else (Chưa có)
    :Màn hình đăng ký;
    :Nhập số điện thoại + email;
    :Nhấn "Gửi mã OTP";
    :OTP Server gửi mã về email;
    :Nhập mã OTP;
    if (OTP hợp lệ?) then (Hợp lệ)
        :Nhập thông tin cá nhân\n(Họ tên, Giới tính, Vai trò);
        :Nhấn "Hoàn tất đăng ký";
        :Tạo tài khoản Firebase Auth;
        :Lưu hồ sơ AppUser vào Firestore;
        :Lưu user_directory, login_directory;
        :Màn hình xác minh email;
        :Gửi email xác minh;
        repeat
            :Chờ xác minh;
        repeat while (Đã xác minh?) is (Chưa) not (Đã)
        :Màn hình chính;
        stop
    else (Không hợp lệ)
        :Hiển thị lỗi OTP;
        :Cho phép nhập lại;
        stop
    endif
endif
@enduml
