@startuml Phan_Ra_Chuc_Nang_Hoan_Chinh
!theme plain
skinparam backgroundColor white
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam rectangleBorderColor black
skinparam rectangleBackgroundColor white
skinparam arrowColor black
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Sơ đồ Phân rã Chức năng\nỨng dụng Geriatriccare

rectangle "Ứng dụng\nGeriatriccare" as Root

rectangle "QL Tình huống\nkhẩn cấp" as SOS
rectangle "Quản lý chỉ số\nhuyết áp" as BP
rectangle "QL lịch uống\nthuốc" as MED
rectangle "QL liên kết\ntài khoản" as LINK
rectangle "QL lịch khám\nsức khỏe" as APT
rectangle "Quản lý\nhồ sơ y tế" as REC

Root --> SOS
Root --> BP
Root --> MED
Root --> LINK
Root --> APT
Root --> REC

' ===== QL Tình huống khẩn cấp =====
rectangle "Kích hoạt\ncảnh báo SOS" as SOS1
rectangle "Phát hiện\nngã tự động" as SOS2
rectangle "Gửi vị trí GPS\nkhẩn cấp" as SOS3
rectangle "Tiếp nhận\ncảnh báo SOS" as SOS4
rectangle "Cập nhật trạng thái\nhỗ trợ khẩn cấp" as SOS5
rectangle "Giải quyết hoặc\nhủy cảnh báo" as SOS6

SOS --> SOS1
SOS --> SOS2
SOS --> SOS3
SOS --> SOS4
SOS --> SOS5
SOS --> SOS6

' ===== Quản lý chỉ số huyết áp =====
rectangle "Ghi chỉ số\nhuyết áp" as BP1
rectangle "Theo dõi lịch sử\nhuyết áp" as BP2

BP --> BP1
BP --> BP2

' ===== QL lịch uống thuốc =====
rectangle "Tạo lịch\nuống thuốc" as MED1
rectangle "Chỉnh sửa lịch\nuống thuốc" as MED2
rectangle "Ngừng lịch\nuống thuốc" as MED3
rectangle "Xem lịch uống\nthuốc theo ngày" as MED4
rectangle "Nhắc lịch\nuống thuốc" as MED5
rectangle "Ghi nhận lịch sử\ndùng thuốc" as MED6

MED --> MED1
MED --> MED2
MED --> MED3
MED --> MED4
MED --> MED5
MED --> MED6

' ===== QL liên kết tài khoản =====
rectangle "Gửi yêu cầu\nliên kết tài khoản" as LINK1
rectangle "Chấp nhận hoặc\ntừ chối yêu cầu" as LINK2
rectangle "Xem danh sách\ntài khoản liên kết" as LINK3
rectangle "Hủy yêu cầu\nliên kết" as LINK4
rectangle "Liên hệ người thân\nqua điện thoại" as LINK5

LINK --> LINK1
LINK --> LINK2
LINK --> LINK3
LINK --> LINK4
LINK --> LINK5

' ===== QL lịch khám sức khỏe =====
rectangle "Tạo lịch khám\nsức khỏe" as APT1
rectangle "Xem danh sách và\ntrạng thái lịch khám" as APT2
rectangle "Nhận hoặc bàn giao\nlịch khám" as APT3
rectangle "Xác nhận hoàn thành\nlịch khám" as APT4

APT --> APT1
APT --> APT2
APT --> APT3
APT --> APT4

' ===== Quản lý hồ sơ y tế =====
rectangle "Tạo hồ sơ y tế" as REC1
rectangle "Xem hồ sơ y tế" as REC2
rectangle "Chỉnh sửa\nhồ sơ y tế" as REC3

REC --> REC1
REC --> REC2
REC --> REC3

@enduml
