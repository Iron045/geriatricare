@startuml Activity_04_QuanLyLichUongThuoc
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activityBorderColor #16A085
skinparam activityBackgroundColor #E8F8F5
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityDiamondBorderColor #F59E0B
skinparam arrowColor #117864
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Biểu đồ Hoạt động - Phân hệ 4: Quản lý Lịch uống thuốc (UC10, UC11, UC12)

|Người thân / Người cao tuổi|
start
:Mở module 'Tủ thuốc gia đình';
if (Thao tác muốn thực hiện?) then (Thiết lập lịch thuốc mới - UC10)
    label sp_add_med
    :Nhấn 'Thêm lịch uống thuốc';
    :Nhập Tên thuốc, Liều lượng, Số lượng (1-20),
    Chọn thời điểm uống (trước/sau ăn),
    Chọn các mốc giờ trong ngày (HH:mm),
    Chọn ngày bắt đầu và ngày kết thúc;
    :Nhấn 'Lưu lịch uống thuốc';
    |Ứng dụng Flutter|
    if (Dữ liệu hợp lệ?) then (Không)
        :Báo lỗi (Tên thuốc rỗng / Chưa có giờ nhắc / Ngày kết thúc < ngày bắt đầu);
        goto sp_add_med
    else (Hợp lệ)
        |Hệ thống Backend (Firebase)|
        :Lưu vào Firestore 'medication_schedules/{id}';
        |Ứng dụng Flutter|
        :Đăng ký thông báo báo thức cục bộ (Local Notifications);
        :Hiển thị lịch thuốc mới vào danh sách;
        stop
    endif
else (Theo dõi & Uống thuốc trong ngày - UC11 & UC12)
    |Hệ thống Backend (Firebase)|
    :Đến khung giờ uống thuốc đã cài đặt;
    |Thiết bị Người cao tuổi|
    :Kích hoạt chuông báo thức, rung & thông báo nhắc thuốc;
    :Người cao tuổi mở ứng dụng xem thẻ thuốc hôm nay;
    if (Người cao tuổi chọn thao tác?) then (Xác nhận 'Đã uống')
        :Nhấn nút 'Đã uống' (UC12);
        |Hệ thống Backend (Firebase)|
        :Tự động ghi nhận takenAt = now;
        :Ghi nhận nhật ký vào 'medication_logs/{id}' (status = 'taken');
        :Cập nhật tỷ lệ tuân thủ điều trị;
    else (Chọn 'Bỏ qua')
        :Nhấn nút 'Bỏ qua' (UC12);
        |Thiết bị Người cao tuổi|
        :Nhập hoặc chọn lý do bỏ qua (skipReason);
        |Hệ thống Backend (Firebase)|
        :Ghi nhận nhật ký vào 'medication_logs/{id}' (status = 'skipped');
    endif
    |Thiết bị Con cái (Từ xa)|
    :Đồng bộ tiến độ uống thuốc thời gian thực của cha mẹ;
    stop
endif
@enduml