@startuml Activity_07_QuanLyHoSoYTe
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activityBorderColor #2C3E50
skinparam activityBackgroundColor #EBEDEF
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityDiamondBorderColor #F59E0B
skinparam arrowColor #1B2631
skinparam titleFontSize 16
skinparam titleFontStyle bold

title Biểu đồ Hoạt động - Phân hệ 7: Quản lý Hồ sơ Y tế (UC19, UC20, UC21)

|Người dùng (Cao tuổi / Con cái)|
start
:Mở mục 'Hồ sơ y tế & Sổ khám bệnh';
if (Thao tác muốn thực hiện?) then (Tra cứu lịch sử khám bệnh - UC21)
    :Nhập từ khóa tìm kiếm (bệnh viện, bác sĩ, chẩn đoán);
    :Chọn bộ lọc theo năm khám;
    |Hệ thống Backend (Firebase)|
    :Truy vấn 'medical_records' theo elderId và bộ lọc;
    :Sắp xếp kết quả giảm dần theo recordDate;
    |Ứng dụng Flutter|
    :Hiển thị danh sách kết quả dạng thẻ tóm tắt;
    :Người dùng chạm vào một thẻ để mở toàn bộ chi tiết;
    stop
elseif (Lưu hồ sơ bệnh án mới - UC19)
    label sp_add_record
    |Người dùng (Cao tuổi / Con cái)|
    :Nhấn 'Tạo hồ sơ bệnh án mới';
    :Nhập Tên bệnh viện, Chẩn đoán bệnh,
    Chọn Ngày khám (từ 2000 đến hiện tại), Bác sĩ, Đơn thuốc tóm tắt;
    :Nhấn 'Lưu hồ sơ';
    |Ứng dụng Flutter|
    if (Chẩn đoán hợp lệ & Ngày khám <= now?) then (Không)
        :Báo lỗi vi phạm trường bắt buộc hoặc ngày khám tương lai;
        goto sp_add_record
    else (Hợp lệ)
        |Hệ thống Backend (Firebase)|
        :Lưu tài liệu vào Firestore 'medical_records/{id}';
        |Ứng dụng Flutter|
        :Chuyển sang màn hình xem chi tiết hồ sơ vừa tạo;
        stop
    endif
else (Quản lý tài liệu đính kèm - UC20)
    |Người dùng (Cao tuổi / Con cái)|
    :Mở chi tiết hồ sơ bệnh án;
    :Nhấn 'Đính kèm tài liệu / Ảnh xét nghiệm';
    :Chọn chụp ảnh bằng Camera hoặc chọn tệp từ Thư viện;
    |Ứng dụng Flutter|
    if (Tệp là JPG/PNG/PDF và Dung lượng <= 10MB?) then (Không hợp lệ)
        :Báo lỗi: 'Định dạng không hỗ trợ hoặc dung lượng quá 10MB';
        stop
    else (Hợp lệ)
        :Nén tối ưu hóa hình ảnh;
        |Hệ thống Backend (Firebase)|
        :Tải tệp lên Firebase Storage 'medical_records/{id}/attachments/{fileId}';
        :Lấy link download an toàn;
        :Cập nhật mảng attachments trong tài liệu Firestore;
        |Ứng dụng Flutter|
        :Hiển thị ảnh thu nhỏ (thumbnail) trên chi tiết bệnh án;
        :Cho phép bấm xem phóng to hoặc bấm Xóa tài liệu;
        stop
    endif
endif
@enduml