rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function myPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber;
    }

    function isLinkedChild(elderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/care_relationships/$(elderId + '_' + request.auth.uid));
    }

    function hasRole(userId, role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.role == role;
    }

    function isCareProvider(userId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.role
          in ['child', 'caregiver'];
    }

    match /users/{userId} {
      allow create: if ownsUser(userId)
        && request.resource.data.role in ['elder', 'child', 'caregiver']
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.phoneNumber is string
        && request.resource.data.email == request.auth.token.email;
      allow read: if ownsUser(userId) || isLinkedChild(userId);
      allow update: if ownsUser(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        && request.resource.data.email == resource.data.email
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /user_directory/{phoneNumber} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneNumber == phoneNumber
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['elder', 'child', 'caregiver']
        && request.resource.data.role
          == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      allow delete: if false;
    }

    match /fcm_tokens/{tokenId} {
      allow create, update: if signedIn()
        && isCareProvider(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.platform in ['android', 'ios', 'web'];
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /health_records/{recordId} {
      allow create: if signedIn()
        && request.resource.data.elderUserId == request.auth.uid
        && request.resource.data.systolicBp is int
        && request.resource.data.diastolicBp is int
        && request.resource.data.systolicBp >= 70
        && request.resource.data.systolicBp <= 250
        && request.resource.data.diastolicBp >= 40
        && request.resource.data.diastolicBp <= 150
        && request.resource.data.systolicBp > request.resource.data.diastolicBp;
      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );
      allow update: if signedIn()
        && isLinkedChild(resource.data.elderUserId)
        && (
          !resource.data.keys().hasAny(['contactedAt'])
          || resource.data.contactedAt == null
        )
        && request.resource.data.contactedAt is timestamp
        && request.resource.data.contactedById == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['contactedAt', 'contactedById']);
      allow delete: if false;
    }

    match /medical_appointments/{appointmentId} {
      allow create: if signedIn()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.assigneeId is string
        && request.resource.data.assigneeName is string
        && exists(/databases/$(database)/documents/care_relationships/$(request.resource.data.elderUserId + '_' + request.resource.data.assigneeId))
        && (
          request.resource.data.elderUserId == request.auth.uid
          || isLinkedChild(request.resource.data.elderUserId)
        );
      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );
      allow update: if signedIn()
        && isLinkedChild(resource.data.elderUserId)
        && request.resource.data.elderUserId == resource.data.elderUserId
        && (
          (
            resource.data.status == 'unassigned'
            && request.resource.data.status == 'accepted'
            && request.resource.data.assigneeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'assigneeId', 'assigneeName', 'acceptedAt', 'updatedAt'])
          )
          || (
            resource.data.status == 'accepted'
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.status in ['unassigned', 'completed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'assigneeId', 'assigneeName', 'releasedById',
              'completedById', 'completedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /login_directory/{phoneNumber} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneNumber == phoneNumber
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/login_directory/$(phoneNumber))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber
          == phoneNumber
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
          == request.auth.token.email;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneNumber == phoneNumber
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /email_directory/{emailKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/email_directory/$(emailKey))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
          == request.auth.token.email;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /medical_visits/{visitId} {
      allow create: if signedIn()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.visitDate is timestamp
        && (
          request.resource.data.elderUserId == request.auth.uid
          || isLinkedChild(request.resource.data.elderUserId)
        );
      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );
      allow update, delete: if false;

      match /documents/{documentId} {
        allow create: if signedIn()
          && request.resource.data.uploadedById == request.auth.uid
          && request.resource.data.elderUserId
            == get(/databases/$(database)/documents/medical_visits/$(visitId)).data.elderUserId
          && (
            request.resource.data.elderUserId == request.auth.uid
            || isLinkedChild(request.resource.data.elderUserId)
          );
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/medical_visits/$(visitId)).data.elderUserId
              == request.auth.uid
            || isLinkedChild(
              get(/databases/$(database)/documents/medical_visits/$(visitId)).data.elderUserId
            )
          );
        allow update, delete: if false;
      }
    }

    match /medication_schedules/{scheduleId} {
      allow create: if signedIn()
        && (
          request.resource.data.elderUserId == request.auth.uid
          || isLinkedChild(request.resource.data.elderUserId)
        );
      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );
      allow update: if signedIn()
        && request.resource.data.elderUserId == resource.data.elderUserId
        && resource.data.elderUserId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
        );
    }

    match /medication_intakes/{intakeId} {
      allow create: if signedIn()
        && request.resource.data.elderUserId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );
      allow update: if signedIn()
        && resource.data.elderUserId == request.auth.uid
        && request.resource.data.elderUserId == resource.data.elderUserId;
      allow delete: if false;
    }

    match /account_links/{linkId} {
      allow create: if signedIn()
        && isCareProvider(request.auth.uid)
        && request.resource.data.childId == request.auth.uid
        && request.resource.data.childPhone == myPhone()
        && request.resource.data.elderPhone is string
        && request.resource.data.elderPhone != myPhone()
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/user_directory/$(request.resource.data.elderPhone)).data.uid
          == request.resource.data.elderId
        && get(/databases/$(database)/documents/user_directory/$(request.resource.data.elderPhone)).data.role
          == 'elder';

      allow read: if signedIn() && (
        resource.data.elderId == request.auth.uid
        || resource.data.childId == request.auth.uid
        || resource.data.childPhone == myPhone()
        || (
          resource.data.status == 'accepted'
          && isLinkedChild(resource.data.elderId)
        )
      );

      allow update: if signedIn() && (
        (
          resource.data.elderId == request.auth.uid
          && hasRole(request.auth.uid, 'elder')
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          resource.data.childId == request.auth.uid
          && isCareProvider(request.auth.uid)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          resource.data.elderId == request.auth.uid
          && request.resource.data.elderName
            == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['elderName', 'updatedAt'])
        )
        ||
        (
          resource.data.childId == request.auth.uid
          && request.resource.data.childName
            == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['childName', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

    match /care_relationships/{relationshipId} {
      allow create: if signedIn()
        && request.resource.data.elderId == request.auth.uid
        && hasRole(request.auth.uid, 'elder')
        && request.resource.data.status == 'accepted'
        && relationshipId == request.auth.uid + '_' + request.resource.data.childId
        && getAfter(/databases/$(database)/documents/account_links/$(request.resource.data.invitationId)).data.elderId
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/account_links/$(request.resource.data.invitationId)).data.childId
          == request.resource.data.childId
        && getAfter(/databases/$(database)/documents/account_links/$(request.resource.data.invitationId)).data.status
          == 'accepted';
      allow read: if signedIn() && (
        resource.data.elderId == request.auth.uid
        || resource.data.childId == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /sos_alerts/{alertId} {
      allow create: if signedIn()
        && hasRole(request.auth.uid, 'elder')
        && request.resource.data.elderUserId == request.auth.uid
        && request.resource.data.triggerMethod in ['button', 'shake']
        && request.resource.data.status == 'active'
        && request.resource.data.acknowledgedAt == null
        && request.resource.data.acknowledgedById == null
        && request.resource.data.resolvedAt == null;

      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );

      allow update: if signedIn() && (
        (
          resource.data.elderUserId == request.auth.uid
          && resource.data.status in ['active', 'acknowledged', 'enRoute', 'arrived']
          && request.resource.data.status == resource.data.status
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.locationAccuracy is number
          && request.resource.data.locationCapturedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['latitude', 'longitude', 'locationAccuracy', 'locationCapturedAt'])
        )
        ||
        (
          isLinkedChild(resource.data.elderUserId)
          && resource.data.status == 'active'
          && request.resource.data.status == 'acknowledged'
          && request.resource.data.acknowledgedAt is timestamp
          && request.resource.data.acknowledgedById == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acknowledgedAt', 'acknowledgedById'])
        )
        ||
        (
          isLinkedChild(resource.data.elderUserId)
          && resource.data.acknowledgedById == request.auth.uid
          && (
            (
              resource.data.status == 'acknowledged'
              && request.resource.data.status == 'enRoute'
              && request.resource.data.enRouteAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'enRouteAt'])
            )
            ||
            (
              resource.data.status == 'enRoute'
              && request.resource.data.status == 'arrived'
              && request.resource.data.arrivedAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'arrivedAt'])
            )
            ||
            (
              resource.data.status == 'arrived'
              && request.resource.data.status == 'resolved'
              && request.resource.data.resolvedAt is timestamp
              && request.resource.data.resolvedById == request.auth.uid
              && request.resource.data.resolutionType in ['safe', 'hospitalized', 'false_alarm']
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'resolvedAt', 'resolvedById', 'resolutionType', 'resolutionNote'])
            )
          )
        )
        ||
        (
          resource.data.elderUserId == request.auth.uid
          && resource.data.status in ['active', 'acknowledged', 'enRoute', 'arrived']
          && request.resource.data.resolvedAt is timestamp
          && (
            (
              resource.data.status == 'active'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelledById == request.auth.uid
              && request.resource.data.cancellationReason is string
              && request.resource.data.cancellationReason.size() > 0
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'resolvedAt', 'cancelledById', 'cancellationReason'])
            )
            ||
            (
              resource.data.status != 'active'
              && request.resource.data.status == 'resolved'
              && (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'resolvedAt'])
                || (
                  request.resource.data.resolvedById == request.auth.uid
                  && request.resource.data.resolutionType == 'safe'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'resolvedAt', 'resolvedById', 'resolutionType', 'resolutionNote'])
                )
              )
            )
          )
        )
      );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/sos_alerts/$(alertId)).data.elderUserId == request.auth.uid
          || isLinkedChild(get(/databases/$(database)/documents/sos_alerts/$(alertId)).data.elderUserId)
        );
        allow create: if signedIn()
          && (
            get(/databases/$(database)/documents/sos_alerts/$(alertId)).data.elderUserId == request.auth.uid
            || isLinkedChild(get(/databases/$(database)/documents/sos_alerts/$(alertId)).data.elderUserId)
          )
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.fromStatus is string
          && request.resource.data.toStatus is string
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /elder_locations/{elderId} {
      allow create, update: if ownsUser(elderId)
        && hasRole(elderId, 'elder')
        && request.resource.data.elderId == elderId
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.accuracyMeters is number;
      allow read: if ownsUser(elderId) || isLinkedChild(elderId);
      allow delete: if false;
    }

    match /medication_history/{historyId} {
      allow create: if signedIn()
        && (
          request.resource.data.elderUserId == request.auth.uid
          || isLinkedChild(request.resource.data.elderUserId)
        )
        && request.resource.data.status in ['taken', 'missed']
        && (
          request.resource.data.status == 'missed'
          || request.resource.data.elderUserId == request.auth.uid
        )
        && request.resource.data.medicationName is string
        && request.resource.data.dosage is string
        && request.resource.data.scheduledAt is timestamp;
      allow read: if signedIn() && (
        resource.data.elderUserId == request.auth.uid
        || isLinkedChild(resource.data.elderUserId)
      );
      allow update: if signedIn()
        && resource.data.elderUserId == request.auth.uid
        && request.resource.data.elderUserId == resource.data.elderUserId
        && resource.data.status == 'missed'
        && request.resource.data.status == 'taken'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'takenAt', 'createdAt', 'medicationName', 'dosage']);
      allow delete: if false;
    }

    match /voice_reminders/{reminderId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.storagePath is string
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds > 0
        && request.resource.data.durationSeconds <= 300;
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
